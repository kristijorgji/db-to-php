includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    paths:
        - src
        - tests
    excludePaths:
        - tests/integration/MySql/Php/output
    level: 6
    phpVersion: 80300
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    # Config/fixture arrays; item types would be mixed, which ECS forbids.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: foreach.nonIterable
            path: src/Data/AbstractEntity.php
