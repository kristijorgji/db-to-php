# Consumed by kristijorgji/php-coding-standard (vendor/bin/kj-php-coding-standard-install-hooks).
# Host PHP only — compose provides MySQL, not a PHP container.
# Run: make dev-init   after composer install / package upgrades.
KJ_PHP_CS_PHP_RUNTIME=host
KJ_PHP_CS_HOOKS=01-markdownlint,02-phpunit-related,03-code-analyse,05-coverage-gate
KJ_PHP_CS_RELATED_SRC_PREFIX=src
KJ_PHP_CS_RELATED_TEST_PREFIX=tests/unit
KJ_PHP_CS_XDEBUG_MODE=off
KJ_PHP_CS_COVERAGE_CLOVER=build/coverage/clover.xml
KJ_PHP_CS_COVERAGE_MIN=99
